+def _origin_is_github(git_cmd, cwd) -> bool:
+    """True when ``origin`` is a GitHub remote (mirrors are not, and own their tags)."""
+    result = _probe(git_cmd, cwd, "config", "--get", "remote.origin.url")
+    if result is None or result.returncode != 0:
+        return False
+    return bool(_GITHUB_ORIGIN.fullmatch(result.stdout.strip()))
+
+
+def _stable_tag_from_origin(git_cmd, cwd) -> tuple[str, str]:
+    """Newest strict semver tag on a mirror origin, with the commit it points at.
+
+    Annotated tags report the tag object on ``refs/tags/<t>`` and the commit on the
+    peeled ``^{}`` ref, so the peel wins; a lightweight tag has only the commit ref.
+    """
+    from hermes_cli.source_check import source_git_env
+
+    result = subprocess.run(
+        [*git_cmd, "ls-remote", "--tags", "origin", "refs/tags/v*"],
+        cwd=cwd, capture_output=True, text=True, encoding="utf-8", errors="replace",
+        check=True, timeout=60, stdin=subprocess.DEVNULL,
+        env=source_git_env(),
+    )
+    tags: dict[str, str] = {}
+    for line in result.stdout.splitlines():
+        parts = line.split()
+        if len(parts) != 2:
+            continue
+        sha, ref = parts
+        name = ref.removeprefix("refs/tags/")
+        peeled = name.endswith("^{}")
+        name = name.removesuffix("^{}")
+        if not STABLE_TAG_RE.fullmatch(name):
+            continue
+        if peeled:
+            tags[name] = sha
+        else:
+            tags.setdefault(name, sha)
+    if not tags:
+        raise ValueError("Mirror origin has no stable release tags")
+    tag = max(tags, key=lambda name: tuple(int(part) for part in name.removeprefix("v").split(".")))
+    return tag, tags[tag]
+
